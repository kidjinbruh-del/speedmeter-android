<?xml version="1.0" encoding="utf-8"?>
<!-- Иконка «Спидометр».

     Что изменилось и почему:
     * дуга стала 270°, а не полукругом. Полукруг в мелком размере читается
       как «радуга» или «улыбка», а три четверти круга — как шкала прибора;
     * стрелка идёт из центра, а не из края: видно, что это показание, а не
       ещё одна дуга; у стрелки есть противовес сзади — так стрелку рисуют
       на настоящих приборах, и силуэт не распадается на «две чёрточки»;
     * появились насечки и ступица с кольцом — на 48dp они дают
       «приборность», но не сливаются: вся графика одной толщины и цвета;
     * длина стрелки доведена до внутренней кромки шкалы: раньше до
       конца не дотягивалась и выглядела короче насечек.

     Плоско, без градиентов: в монохромной маске Android 13+ система берёт
     только альфу, и градиент превратился бы в серое пятно.

     Холст 108×108. Безопасная зона адаптивной иконки — круг радиусом 33
     от центра (54,54); самая дальняя точка рисунка — 27, всё с запасом. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- шкала: 270°, от 135° до 45° -->
    <path
        android:pathData="M37,71 A24,24 0 1 1 71,71"
        android:strokeColor="#3BE8D4"
        android:strokeWidth="8"
        android:strokeLineCap="round" />

    <!-- насечки внутри шкалы: слева, сверху, справа -->
    <path
        android:pathData="M37,54 L32,54"
        android:strokeColor="#3BE8D4"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <path
        android:pathData="M54,32 L54,37"
        android:strokeColor="#3BE8D4"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
    <path
        android:pathData="M71,54 L76,54"
        android:strokeColor="#3BE8D4"
        android:strokeWidth="3"
        android:strokeLineCap="round" />

    <!-- стрелка: противовес до r=9, жало до внутренней кромки шкалы r=20 -->
    <path
        android:pathData="M47.6,60.4 L68.2,39.8"
        android:strokeColor="#3BE8D4"
        android:strokeWidth="7"
        android:strokeLineCap="round" />

    <!-- ступица: кольцо над стрелкой + ось -->
    <path
        android:pathData="M54,54 m-5.5,0 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0"
        android:strokeColor="#3BE8D4"
        android:strokeWidth="2.5" />
    <path
        android:pathData="M54,54 m-2.2,0 a2.2,2.2 0 1,0 4.4,0 a2.2,2.2 0 1,0 -4.4,0"
        android:fillColor="#3BE8D4" />
</vector>

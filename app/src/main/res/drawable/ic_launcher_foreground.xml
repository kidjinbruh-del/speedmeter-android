<?xml version="1.0" encoding="utf-8"?>
<!-- Иконка «Спидометр» — упрощённая.

     Прежняя была дугой шкалы, поверх которой шла заполненная дуга того же
     радиуса, стрелка и круглый центр: четыре фигуры, четыре цвета. Заполненная
     часть дуги в мелком размере сливалась с основной, и оставалась дуга со
     стрелкой — то есть самая сложная часть была не видна.

     Сейчас дуга и стрелка одного цвета: датчик и стрелка. Круглый центр убран,
     стрелка приходит в начало дуги и идёт до её середины — короче она в
     мелком размере не читалась, оставался просто ободок.

     Плоско, без градиентов: в монохромной маске Android 13+ система берёт
     только альфу.

     Холст 108×108. Безопасная зона — круг радиусом 36 от центра (54,54);
     концы дуги отстоят от центра на 24, всё с запасом внутри. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- дуга шкалы -->
    <path
        android:pathData="M32,70 A22,22 0 1 1 76,70"
        android:strokeColor="#35E0D0"
        android:strokeWidth="8"
        android:strokeLineCap="round" />

    <!-- стрелка -->
    <path
        android:pathData="M54,70 L71,44"
        android:strokeColor="#35E0D0"
        android:strokeWidth="7"
        android:strokeLineCap="round" />
</vector>
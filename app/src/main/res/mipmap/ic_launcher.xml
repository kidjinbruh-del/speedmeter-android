<?xml version="1.0" encoding="utf-8"?>
<!-- Иконка для Android 5–7, где адаптивных ещё нет (minSdk 23).

     Файла не было вообще: в mipmap-anydpi-v26 лежала только адаптивная иконка,
     поэтому на Android 5–7 значок приложения был пустым. Слои сложены без
     отступов, чтобы рисунок занимал те же 2/3 от края, что и в адаптивной
     иконке. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>